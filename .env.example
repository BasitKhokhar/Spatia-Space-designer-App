# Copy to .env and set the backend URL to run the app full-stack.
# Leave unset/empty to run fully local-first (offline demo mode).
#
#   Android emulator  -> host machine is 10.0.2.2
#   iOS simulator     -> localhost works
#   Physical device   -> use your machine's LAN IP (e.g. http://192.168.1.20:5004)
#
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:5004
